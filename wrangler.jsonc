{
  "name": "aftercredits-film-club",
  "main": "server/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aftercredits-review",
      "database_id": "local",
      "migrations_dir": "migrations",
    },
  ],
}
